# ==============================================================================
# Database Configuration (Neon PostgreSQL)
# ==============================================================================
DATABASE_URL="postgresql://user:password@ep-sample-pooler.neon.tech/shoestore?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.neon.tech/shoestore?sslmode=require"

# ==============================================================================
# Auth.js / NextAuth v5 Configuration
# ==============================================================================
AUTH_SECRET="generate-a-strong-random-32-byte-secret"
NEXTAUTH_SECRET="generate-a-strong-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# Admin Initial Credentials (Used for seeding and admin access authorization)
# ==============================================================================
ADMIN_EMAIL="admin@shoestore.com"
ADMIN_PASSWORD="super-secure-admin-password"
ADMIN_LOGIN_PATH="/admin/login"

# ==============================================================================
# Cloudinary (Product image uploads)
# ==============================================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ==============================================================================
# Stripe Payment Gateway
# ==============================================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"

# ==============================================================================
# Khalti Payment Gateway (Nepal Domestic Payments)
# ==============================================================================
NEXT_PUBLIC_KHALTI_PUBLIC_KEY="your-khalti-public-key"
KHALTI_SECRET_KEY="your-khalti-live-or-test-secret-key"
KHALTI_API_URL="https://dev.khalti.com/api/v2" # Production: https://khalti.com/api/v2

# ==============================================================================
# Cron Job Authentication (Order cleanup & maintenance)
# ==============================================================================
CRON_SECRET="generate-a-secret-for-cron-bearer-token"

# ==============================================================================
# Transactional Email (Resend) - Optional / Phase 5
# ==============================================================================
# RESEND_API_KEY="re_your_resend_api_key"
# EMAIL_FROM="ABXV Store <orders@yourdomain.com>"

# ==============================================================================
# ExchangeRate-API (https://app.exchangerate-api.com/dashboard)
# ==============================================================================
EXCHANGERATE_API_KEY="your-exchangerate-api-key"

# ==============================================================================
# Upstash Redis (Distributed Rate Limiting for Serverless / Edge)
# Get credentials at: https://console.upstash.com/
# ==============================================================================
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# ==============================================================================
# Sentry Error Monitoring & Observability
# Create project at: https://sentry.io/
# ==============================================================================
NEXT_PUBLIC_SENTRY_DSN="https://your-public-dsn@o0.ingest.sentry.io/0"
SENTRY_DSN="https://your-server-dsn@o0.ingest.sentry.io/0"
# SENTRY_AUTH_TOKEN="sntrys_your-auth-token-for-source-maps-upload"
# SENTRY_ORG="your-sentry-org-slug"
# SENTRY_PROJECT="shoe-store"


